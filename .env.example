# Copy to .env and set what this machine needs.
# Vite reads these at start, for the dev and preview servers.

# The bridge the UI talks to (/api, /ws). The default is the loopback of the
# machine that runs the bridge.
AGENT_HUMEN_COMPUTER_BRIDGE_URL=http://127.0.0.1:7071
# AGENT_HUMEN_COMPUTER_BRIDGE_HOST=127.0.0.1
# AGENT_HUMEN_COMPUTER_BRIDGE_PORT=7071

# The noVNC of the computer, proxied under /novnc and /websockify.
AGENT_HUMEN_COMPUTER_NOVNC_PORT=6080

# The keys of the model clients in core/modules. Never commit .env.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# The agent token of the MCP server (core/tools/mcp) and, when the bridge
# grows its auth, of every client of the bridge.
# AGENT_HUMEN_COMPUTER_TOKEN=
